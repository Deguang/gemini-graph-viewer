{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.1",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icon.png"
  },
  "permissions": [
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://gemini.google.com/*"
      ],
      "js": [
        "shared/config.js",
        "shared/css-engine.js",
        "shared/markdown.js",
        "shared/mermaid-clean.js",
        "lib/mermaid.min.js",
        "content.js"
      ],
      "css": [
        "styles/mermaid.css",
        "styles/actions.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/mermaid.min.js"
      ],
      "matches": [
        "*://gemini.google.com/*"
      ]
    }
  ],
  "default_locale": "en"
}
