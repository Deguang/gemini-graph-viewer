{
  "manifest_version": 3,
  "name": "Gemini Polish & Graph Viewer",
  "version": "1.1.17",
  "description": "Professional split-view Mermaid diagram renderer and reading typography/minimalism enhancer for Google Gemini.",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icon.png"
  },
  "permissions": ["scripting", "tabs", "storage"],
  "host_permissions": [
    "*://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["lib/mermaid.min.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/mermaid.min.js"],
      "matches": ["*://gemini.google.com/*"]
    }
  ]
}
