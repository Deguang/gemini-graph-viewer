{
  "name": "gemini-polish",
  "version": "1.3.0",
  "description": "Customizable reading experience for Google Gemini: typography, minimal mode, accent colors, and a split-view Mermaid diagram renderer.",
  "scripts": {
    "test": "node tests/settings-pipeline.mjs",
    "zip": "mkdir -p release && zip -r release/gemini-polish-v$npm_package_version.zip . -x '*.git*' -x '*.DS_Store*' -x 'node_modules/*' -x 'package.json' -x 'package-lock.json' -x 'release.sh' -x 'release/*' -x 'docs/*' -x '.github/*' -x 'tests/*' -x 'preview/*' -x '.claude/*' -x 'tug.yml' -x '.node-version' -x '*.md' -x 'test-mermaid.*' -x 'manifest.json_tmp'",
    "upload": "bash release.sh --upload-only",
    "release": "bash release.sh"
  },
  "dependencies": {
    "jsdom": "^27.0.1",
    "puppeteer": "^24.42.0"
  }
}
